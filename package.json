{
  "name": "agent-mesh-runtime",
  "version": "0.1.0",
  "description": "Provider-neutral distributed agent runtime with protocol objects, SQLite ledger, registry, policy, memory, artifacts, and model adapters.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/server/index.js",
    "build": "tsc"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "openai": "^6.9.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
